--- a/cctools-port/cctools/ld64/src/ld/OutputFile.cpp
+++ b/cctools-port/cctools/ld64/src/ld/OutputFile.cpp
@@ -5312,6 +5312,37 @@
 		}
 	}
 
+	// A dylib that owns an import proxy but is not in state.dylibs gets no ordinal from the loop
+	// above, and encoding that proxy then aborts in dylibToOrdinal() and in
+	// compressedOrdinalForAtom(). Two dylib files can carry the same install name and only one of
+	// them reaches state.dylibs: InputFiles::addDylib keys _installPathToDylibs by install path and
+	// keeps one file per path, while InputFiles::searchLibraries asks each implicitly linked file it
+	// finds there. The SDK's usr/lib/libobjc.tbd and usr/lib/libobjc.A.tbd are such a pair, and a
+	// client that imports _objc_getClass through the second owns a proxy whose ordinal does not
+	// exist. Give every dylib that owns a proxy an ordinal, and add it to the load list unless some
+	// dylib already loaded carries that install path, so the library the symbol came from is the one
+	// the output loads and the one the symbol binds to. Nothing that linked before changes: a dylib
+	// that already has an ordinal is skipped, and one without an ordinal is exactly the case that
+	// used to abort.
+	for (const ld::Internal::FinalSection* sect : state.sections) {
+		if ( sect->type() != ld::Section::typeImportProxies ) { continue; }
+		for (const ld::Atom* rawAtom : sect->atoms) {
+			const ld::dylib::File* aDylib = dynamic_cast<const ld::dylib::File*>(rawAtom->file());
+			if ( aDylib == NULL ) { continue; }
+			if ( _dylibToOrdinal.find(aDylib) != _dylibToOrdinal.end() ) { continue; }
+			int ordinal;
+			if ( this->hasOrdinalForInstallPath(aDylib->installPath(), &ordinal) ) {
+				// some dylib already in the load list carries that install path, bind to it
+				_dylibToOrdinal[aDylib] = ordinal;
+			}
+			else {
+				// the dylib exporting this symbol is not loaded, so load it and give it an ordinal
+				_dylibsToLoad.push_back(const_cast<ld::dylib::File*>(aDylib));
+				_dylibToOrdinal[aDylib] = _dylibsToLoad.size();
+			}
+		}
+	}
+
 	_noReExportedDylibs = !hasReExports;
 }
 
