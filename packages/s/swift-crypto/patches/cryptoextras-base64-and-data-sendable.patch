+//===----------------------------------------------------------------------===//
+//
+// charon: the Sendable conformance of Data for the iOS 6.1.3 floor. Foundation declares Data Sendable on the SDKs that carry it;
+// on the 16.4 SDK at armv7 with this floor it does not, so every Sendable value that stores Data fails to compile. Data is a value
+// type, and the conformance reaches every importer of CryptoExtras, as Foundation's own would.
+//
+//===----------------------------------------------------------------------===//
+
+#if canImport(FoundationEssentials)
+import FoundationEssentials
+#else
+import Foundation
+#endif
+
+extension Data: @unchecked @retroactive Sendable {}
