+/* The source type that replaces its pending data, which iOS 11 brought; NULL on a release without it. */
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wunguarded-availability-new"
+static inline dispatch_source_type_t _Nullable
+_swift_dispatch_source_type_DATA_REPLACE(void) {
+  if (&_dispatch_source_type_data_replace == NULL) {
+    return NULL;
+  }
+  return DISPATCH_SOURCE_TYPE_DATA_REPLACE;
+}
+#pragma clang diagnostic pop
