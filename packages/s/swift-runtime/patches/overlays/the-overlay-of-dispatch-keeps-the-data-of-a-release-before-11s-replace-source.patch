diff --git a/stdlib/public/Darwin/Dispatch/Source.swift b/stdlib/public/Darwin/Dispatch/Source.swift
--- a/stdlib/public/Darwin/Dispatch/Source.swift
+++ b/stdlib/public/Darwin/Dispatch/Source.swift
@@ -14,3 +14,59 @@
 @_implementationOnly import _SwiftDispatchOverlayShims
+import Darwin
+import ObjectiveC
 
+/* A source that replaces its pending data arrived in iOS 11. Before it the overlay makes a source that ORs, beside a
+   record of the latest value replaced into it: replace(data:) records the value and merges a 1, which coalesces the
+   calls of the handler as the pending data of the release's source does. The event handler is set wrapped, and the
+   wrapper takes a snapshot of the latest value on entry: the data the handler reads is the value it was called with,
+   and a value replaced while it runs is the next call's, as on the release. */
+internal final class _ReplacedData {
+	private let lock = UnsafeMutablePointer<pthread_mutex_t>.allocate(capacity: 1)
+	private var latest: UInt = 0
+	private var called: UInt = 0
+
+	init() { pthread_mutex_init(lock, nil) }
+
+	deinit {
+		pthread_mutex_destroy(lock)
+		lock.deallocate()
+	}
+
+	/// The value of the latest replace(data:), for that call to record.
+	func replace(_ value: UInt) {
+		pthread_mutex_lock(lock)
+		latest = value
+		pthread_mutex_unlock(lock)
+	}
+
+	/// What the event handler is called with: the latest value at its entry, until its next entry.
+	func enter() {
+		pthread_mutex_lock(lock)
+		called = latest
+		pthread_mutex_unlock(lock)
+	}
+
+	var value: UInt {
+		pthread_mutex_lock(lock)
+		defer { pthread_mutex_unlock(lock) }
+		return called
+	}
+}
+
+private var _replacedDataKey: UInt8 = 0
+
+private func _replacedData(of source: DispatchSource) -> _ReplacedData? {
+	return objc_getAssociatedObject(source, &_replacedDataKey) as? _ReplacedData
+}
+
+/// The handler of a replace source, wrapped to take its snapshot on entry; any other handler as it is.
+private func _snapshotting(_ handler: @escaping @convention(block) () -> Void, of source: DispatchSource) -> @convention(block) () -> Void {
+	guard let replaced = _replacedData(of: source) else { return handler }
+	return { replaced.enter(); handler() }
+}
+
+private func _snapshotting(_ handler: (@convention(block) () -> Void)?, of source: DispatchSource) -> (@convention(block) () -> Void)? {
+	return handler.map { _snapshotting($0, of: source) }
+}
