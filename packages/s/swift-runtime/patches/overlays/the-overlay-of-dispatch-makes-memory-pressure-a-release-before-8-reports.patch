diff --git a/stdlib/public/Darwin/Dispatch/Source.swift b/stdlib/public/Darwin/Dispatch/Source.swift
--- a/stdlib/public/Darwin/Dispatch/Source.swift
+++ b/stdlib/public/Darwin/Dispatch/Source.swift
@@ -47,6 +47,23 @@
 
 private var _replacedDataKey: UInt8 = 0
 
+/* The memory pressure source type arrived in iOS 8. Before it memory pressure is reported by the source type that came
+   first, with NOTE_VM_PRESSURE: the one event iOS 6 and 7 have, which is what iOS 8 calls a warning. The source is made
+   for that event when the mask asks for warnings; normal and critical are events those releases never report, so a
+   mask that asks for them alone gets a source that never fires. The overlay keeps the mask that was asked for beside the
+   source and answers its mask and its data in the events of the newer type. */
+internal final class _RequestedPressure {
+	let mask: UInt
+
+	init(_ mask: UInt) { self.mask = mask }
+}
+
+private var _requestedPressureKey: UInt8 = 0
+
+private func _requestedPressure(of source: DispatchSource) -> _RequestedPressure? {
+	return objc_getAssociatedObject(source, &_requestedPressureKey) as? _RequestedPressure
+}
+
 private func _replacedData(of source: DispatchSource) -> _ReplacedData? {
 	return objc_getAssociatedObject(source, &_replacedDataKey) as? _ReplacedData
 }
@@ -204,8 +221,13 @@
 	}
 
 	public class func makeMemoryPressureSource(eventMask: MemoryPressureEvent, queue: DispatchQueue? = nil) -> DispatchSourceMemoryPressure {
-		return _swift_dispatch_source_create(
-			_swift_dispatch_source_type_MEMORYPRESSURE(), 0, eventMask.rawValue, queue) as DispatchSourceMemoryPressure
+		if let type = _swift_dispatch_source_type_MEMORYPRESSURE() {
+			return _swift_dispatch_source_create(type, 0, eventMask.rawValue, queue) as DispatchSourceMemoryPressure
+		}
+		let pressure = eventMask.contains(.warning) ? _swift_dispatch_vm_pressure() : 0
+		let source = _swift_dispatch_source_create(_swift_dispatch_source_type_VM(), 0, pressure, queue)
+		objc_setAssociatedObject(source, &_requestedPressureKey, _RequestedPressure(eventMask.rawValue), .OBJC_ASSOCIATION_RETAIN)
+		return source as DispatchSourceMemoryPressure
 	}
 
 	public class func makeProcessSource(identifier: pid_t, eventMask: ProcessEvent, queue: DispatchQueue? = nil) -> DispatchSourceProcess {
@@ -281,12 +303,20 @@
 
 extension DispatchSourceMemoryPressure {
 	public var data: DispatchSource.MemoryPressureEvent {
-		let data = __dispatch_source_get_data(self as! DispatchSource)
+		let source = self as! DispatchSource
+		let data = __dispatch_source_get_data(source)
+		if _requestedPressure(of: source) != nil {
+			return data != 0 ? .warning : []
+		}
 		return DispatchSource.MemoryPressureEvent(rawValue: data)
 	}
 
 	public var mask: DispatchSource.MemoryPressureEvent {
-		let mask = __dispatch_source_get_mask(self as! DispatchSource)
+		let source = self as! DispatchSource
+		if let requested = _requestedPressure(of: source) {
+			return DispatchSource.MemoryPressureEvent(rawValue: requested.mask)
+		}
+		let mask = __dispatch_source_get_mask(source)
 		return DispatchSource.MemoryPressureEvent(rawValue: mask)
 	}
 }
diff --git a/stdlib/public/SwiftShims/DispatchOverlayShims.h b/stdlib/public/SwiftShims/DispatchOverlayShims.h
--- a/stdlib/public/SwiftShims/DispatchOverlayShims.h
+++ b/stdlib/public/SwiftShims/DispatchOverlayShims.h
@@ -20,6 +20,9 @@
 #define SWIFT_STDLIB_SHIMS_DISPATCHSHIMS_H
 
 #include <dispatch/dispatch.h>
+#if __APPLE__
+#include <sys/event.h>
+#endif
 
 #ifdef __OBJC__
 #define SWIFT_DISPATCH_RETURNS_RETAINED __attribute__((__ns_returns_retained__))
@@ -111,7 +114,34 @@
 #if __APPLE__
 SWIFT_DISPATCH_SOURCE_TYPE(MACH_SEND)
 SWIFT_DISPATCH_SOURCE_TYPE(MACH_RECV)
-SWIFT_DISPATCH_SOURCE_TYPE(MEMORYPRESSURE)
+
+/* The memory pressure source type, which iOS 8 brought; NULL on a release without it. */
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wunguarded-availability-new"
+static inline dispatch_source_type_t _Nullable
+_swift_dispatch_source_type_MEMORYPRESSURE(void) {
+  if (&_dispatch_source_type_memorypressure == NULL) {
+    return NULL;
+  }
+  return DISPATCH_SOURCE_TYPE_MEMORYPRESSURE;
+}
+#pragma clang diagnostic pop
+
+/* What reported memory pressure before it: libdispatch has exported this source type since iOS 4.3 and the SDK no longer
+   declares it, and the event is NOTE_VM_PRESSURE of <sys/event.h>. It is imported weakly and asked for only where the
+   type above is NULL. */
+extern const struct dispatch_source_type_s _dispatch_source_type_vm __attribute__((weak_import));
+
+static inline dispatch_source_type_t
+_swift_dispatch_source_type_VM(void) {
+  return &_dispatch_source_type_vm;
+}
+
+static inline unsigned long
+_swift_dispatch_vm_pressure(void) {
+  return NOTE_VM_PRESSURE;
+}
+
 SWIFT_DISPATCH_SOURCE_TYPE(PROC)
 SWIFT_DISPATCH_SOURCE_TYPE(VNODE)
 #endif
