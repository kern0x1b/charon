    {
      "api": "-[CLLocationManager stopRangingBeaconsInRegion:]",
      "kind": "method",
      "introduced": "7.0",
      "status": "implemented",
      "facts": "facts/CoreLocation/CLBeacon.md",
      "source": "CoreLocation 12.0 arm64"
    },
    {
      "api": "-[CLLocationManagerDelegate locationManager:didRangeBeacons:inRegion:]",
      "kind": "method",
      "introduced": "7.0",
      "status": "absent",
      "reason": "the release's location daemon cannot range beacons, so nothing ever finds one",
      "effect": "the selector is never sent, so a delegate that implements it is simply not called, and +isRangingAvailable answers NO",
      "facts": "facts/CoreLocation/CLBeacon.md"
    }
  ]
