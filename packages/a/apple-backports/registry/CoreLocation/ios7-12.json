    },
    {
      "api": "CLBeaconRegion.notifyEntryStateOnDisplay",
      "kind": "property",
      "introduced": "7.0",
      "status": "inert",
      "reason": "nothing in the release watches for the display to come on and asks the daemon about a region's state then",
      "effect": "the value is kept and answered back, and the delegate is never told an entry state when the display turns on",
      "facts": "facts/CoreLocation/CLBeacon.md"
    },
    {
      "api": "-[CLLocationManager startRangingBeaconsInRegion:]",
      "kind": "method",
