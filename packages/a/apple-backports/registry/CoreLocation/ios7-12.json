    {
      "api": "CLBeacon",
      "kind": "class",
      "introduced": "7.0",
      "status": "implemented",
      "facts": "facts/CoreLocation/CLBeacon.md",
      "source": "CoreLocation 12.0 arm64"
    },
    {
      "api": "CLBeaconRegion.notifyEntryStateOnDisplay",
      "kind": "property",
      "introduced": "7.0",
      "status": "inert",
      "reason": "nothing in the release watches for the display to come on and asks the daemon about a region's state then",
      "effect": "the value is kept and answered back, and the delegate is never told an entry state when the display turns on",
      "facts": "facts/CoreLocation/CLBeacon.md"
    },
    {
      "api": "-[CLLocationManager startRangingBeaconsInRegion:]",
      "kind": "method",
      "introduced": "7.0",
      "status": "implemented",
      "facts": "facts/CoreLocation/CLBeacon.md",
      "source": "CoreLocation 12.0 arm64"
    },
    {
      "api": "-[CLLocationManager stopRangingBeaconsInRegion:]",
      "kind": "method",
      "introduced": "7.0",
      "status": "implemented",
      "facts": "facts/CoreLocation/CLBeacon.md",
      "source": "CoreLocation 12.0 arm64"
    },
    {
      "api": "-[CLLocationManagerDelegate locationManager:didRangeBeacons:inRegion:]",
      "kind": "method",
      "introduced": "7.0",
      "status": "absent",
      "reason": "the release's location daemon cannot range beacons, so nothing ever finds one",
      "effect": "the selector is never sent, so a delegate that implements it is simply not called, and +isRangingAvailable answers NO",
      "facts": "facts/CoreLocation/CLBeacon.md"
    },
    {
      "api": "CLFloor",
      "kind": "class",
      "introduced": "8.0",
      "status": "implemented",
      "facts": "facts/CoreLocation/CLVisit.md",
      "source": "CoreLocation 12.0 arm64"
    },
    {
      "api": "CLLocation.floor",
      "kind": "property",
      "introduced": "8.0",
      "status": "implemented",
      "facts": "facts/CoreLocation/CLVisit.md",
